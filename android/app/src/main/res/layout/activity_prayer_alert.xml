<?xml version="1.0" encoding="utf-8"?>
<!-- Tam ekran vakit bildirimi: sade Arctic koyu tasarım (logo, konum, giren vakit, anlık saat, sıradaki vakit) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alertRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alert_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/alertLogo"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="Tam Vakti"
            android:src="@drawable/logo_full" />

        <TextView
            android:id="@+id/alertPlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/alert_pill"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:text="Tam Vakti"
            android:textColor="@color/alert_text2"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alertTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="Öğle vakti girdi"
            android:textColor="@color/alert_accent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/alertClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:fontFamily="monospace"
            android:textColor="@color/alert_text"
            android:textSize="76sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/alertDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:format12Hour="d MMMM EEEE"
            android:format24Hour="d MMMM EEEE"
            android:textColor="@color/alert_muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/alertNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/alert_pill"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:text=""
            android:textColor="@color/alert_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Düğmeler her zaman görünür -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/alertClose"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="@color/alert_btn"
            android:text="Tamam"
            android:textAllCaps="false"
            android:textColor="@color/alert_btn_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/alertOpen"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:text="Uygulamayı aç"
            android:textAllCaps="false"
            android:textColor="@color/alert_muted"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
