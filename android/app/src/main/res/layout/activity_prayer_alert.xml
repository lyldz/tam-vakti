<?xml version="1.0" encoding="utf-8"?>
<!-- Tam ekran vakit bildirimi: logo, anlık saat, il/ilçe, giren vakte ait bilgiler -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alertRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alert_bg"
    android:orientation="vertical">

  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/alertLogo"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:contentDescription="Tam Vakti"
            android:src="@drawable/logo_full" />

        <TextView
            android:id="@+id/alertTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Öğle vakti girdi"
            android:textColor="@color/alert_accent"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/alertClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:fontFamily="monospace"
            android:textColor="@color/alert_text"
            android:textSize="76sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/alertDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="d MMMM EEEE"
            android:format24Hour="d MMMM EEEE"
            android:textColor="@color/alert_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/alertPlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/alert_pill"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:text="Konya / Ilgın"
            android:textColor="@color/alert_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/alert_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/alertTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vakit girişi 12:42"
                android:textColor="@color/alert_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alertInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text=""
                android:textColor="@color/alert_text2"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/alertNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text=""
                android:textColor="@color/alert_accent"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
  </ScrollView>

    <!-- Düğmeler her zaman görünür (sistem çubuğu boşlukları kodda uygulanır) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">
        <Button
            android:id="@+id/alertClose"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="@color/alert_btn"
            android:text="Tamam"
            android:textAllCaps="false"
            android:textColor="@color/alert_btn_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/alertOpen"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:text="Uygulamayı aç"
            android:textAllCaps="false"
            android:textColor="@color/alert_muted"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
