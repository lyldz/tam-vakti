<?xml version="1.0" encoding="utf-8"?>
<!-- Tam ekran vakit bildirimi: logo, anlık saat, il/ilçe, giren vakte ait bilgiler -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:minHeight="640dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="40dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <ImageView
            android:id="@+id/alertLogo"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:contentDescription="Tam Vakti"
            android:src="@drawable/logo_full" />

        <TextView
            android:id="@+id/alertTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="Öğle vakti girdi"
            android:textColor="#38BDF8"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/alertClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:fontFamily="monospace"
            android:textColor="#F8FAFC"
            android:textSize="76sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/alertDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="d MMMM EEEE"
            android:format24Hour="d MMMM EEEE"
            android:textColor="#94A3B8"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/alertPlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/alert_pill"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:text="Konya / Ilgın"
            android:textColor="#E2E8F0"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/alert_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/alertTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vakit girişi 12:42"
                android:textColor="#F1F5F9"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alertInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text=""
                android:textColor="#CBD5E1"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/alertNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text=""
                android:textColor="#7DD3FC"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/alertClose"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#0EA5E9"
            android:text="Tamam"
            android:textAllCaps="false"
            android:textColor="#04111F"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/alertOpen"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:text="Uygulamayı aç"
            android:textAllCaps="false"
            android:textColor="#94A3B8"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
